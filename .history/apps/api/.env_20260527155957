# SweetCare API — Environment Variables
# Copy to .env and fill in all values before running locally
# NEVER commit the actual .env file

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL — use connection pooler (PgBouncer) in production
DATABASE_URL=postgresql://sweetcare:changeme@localhost:5432/sweetcare_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT secrets — generate with: openssl rand -hex 32
# SECURITY: Must be different values, min 32 chars each
JWT_ACCESS_SECRET=7537f1e351c17da21d44a1bbc8f982b47dce4ab141837a1f70793597732abc03
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# PHI column encryption — generate with: openssl rand -hex 32
# SECURITY: Loss of this key = permanent loss of encrypted PHI. Store in Secrets Manager.
PHI_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# Redis
REDIS_URL=redis://localhost:6379

# AI service (internal network — not publicly reachable)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# CORS — comma-separated list of allowed origins
# Example: https://app.sweetcare.com.br,https://staging.sweetcare.com.br
CORS_ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=info
